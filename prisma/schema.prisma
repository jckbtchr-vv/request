// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  password     String       // hashed
  createdAt    DateTime     @default(now())
  submissions  Submission[]
}

model Submission {
  id           String   @id @default(cuid())
  content      String   // link or quote
  socialHandle String
  email        String?  // for notification when visual is created
  isPublic     Boolean  @default(true) // show in vote/browse columns
  status       String   @default("pending") // pending, approved, completed, rejected
  votes        Int      @default(0)
  response     String?  // admin notes
  responseUrl  String?  // uploaded visual URL
  userId       String?  // optional link to user account
  user         User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Standalone completed visuals uploaded by admin (not tied to submissions)
model CompletedVisual {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  createdAt   DateTime @default(now())
}
