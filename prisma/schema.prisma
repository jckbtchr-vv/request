// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Submission {
  id           String   @id @default(cuid())
  content      String   // link or quote
  socialHandle String
  email        String?  // for notification when visual is created
  status       String   @default("pending") // pending, approved, completed, rejected
  votes        Int      @default(0)
  response     String?  // admin notes
  responseUrl  String?  // uploaded visual URL
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
